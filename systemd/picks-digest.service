# picks-digest.service — one-shot unit triggered by picks-digest.timer.
# Merged from cryptonomicsed-byte/mycelium-tools (P2-01). Template only: install.sh
# copies it on request; nothing is enabled automatically.

[Unit]
Description=Fetch and print the picks digest

[Service]
Type=oneshot
# Environment=PICKS_URL=http://your.relay.host:8003/api/picks
# EnvironmentFile=-%h/.config/mycelium-tools/picks-digest.env
ExecStart=/usr/bin/env picks-digest
StandardOutput=journal
StandardError=journal
